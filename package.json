{
  "name": "@nightlogue-llc/ui-components",
  "version": "0.0.0",
  "description": "Framework-independent UI components, design tokens, and project themes for Nightlogue LLC projects.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nightlogue-LLC/ui-components.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.css": "./dist/components/*/*.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./themes/*.css": "./dist/themes/*/*.css",
    "./theme-assets/*": "./dist/themes/*",
    "./projects/*.css": "./dist/projects/*/*.css",
    "./projects/*": {
      "types": "./dist/projects/*/index.d.ts",
      "import": "./dist/projects/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:lan": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build && node scripts/check-storybook-build.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:check": "publint && node scripts/smoke-consumer.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run package:check && npm run build-storybook",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/html-vite": "^10.6.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "storybook": "^10.6.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
